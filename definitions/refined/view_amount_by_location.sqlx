config {
    type: "view",
    name: "view_amount_by_location",
    description: "Total sales amount aggregated by location and type"
}

SELECT
  location_id,
  location_name,
  location_type,
  SUM(amount) AS total_revenue,
  COUNT(DISTINCT order_id) AS total_orders
FROM
  ${ref("fact_order")}
GROUP BY
  1,
  2,
  3
ORDER BY
  total_revenue DESC
